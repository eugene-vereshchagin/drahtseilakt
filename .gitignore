# Original game data and anything derived from it (copyrighted: never commit)
/cd/
/game/
/data
/maps/
/mods/
*.nmo
*.NMO
*.cmo
*.CMO
/re/
/out/
*.iso
*.cue
*.mdf
*.nrg

# Build output
/build/
/build*/
/dist/

# Docs site
node_modules/
docs/.vitepress/cache/
docs/.vitepress/dist/
docs/public/play/*.wasm

# Play page runtime, copied from npm by docs/scripts/vendor-web.sh
docs/public/play/vendor/

# Downloaded toolchains and runners (tools/fetch-gasm-sdk.sh, tools/fetch-gasm-runner.sh)
/.deps/

# Python
tools/.venv/
__pycache__/
*.pyc

# OS / editor
.DS_Store
*.swp
.vscode/
.idea/


# Cargo build output
/target/

# Fuzzing: findings, logs and scratch files of the stable fuzzer (crates/fuzzkit), cargo-fuzz's corpus and build
/fuzz/artifacts/
/fuzz/corpus/
/fuzz/target/
/fuzz/coverage/

# Levels and textures stay on disk only until the release (owner, 2026-11-10): git holds the code and the rest.
# Level folders keep their text sources (level.txt, level.lvl, pilot/*.txt, READMEs) in git.
/levels/**/*.*
!/levels/**/*.txt
!/levels/**/*.md
/assets/levels/**/level.bin
/assets/levels/**/level.gltf
/levels-legacy_delme/**/level.bin
/levels-legacy_delme/**/level.gltf
/assets/own/3D Entities/MenuLevel/level.bin
/assets/own/3D Entities/MenuLevel/level.gltf
/assets/**/*.png
/assets/**/*.jpg
/assets/**/*.jpeg
/assets/**/*.bmp
/assets/**/*.tga
/assets/**/*.dds
/levels-legacy_delme/**/*.png
/levels-legacy_delme/**/*.jpg
