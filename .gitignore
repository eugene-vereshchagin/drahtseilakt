/game/
/data
/maps/
/mods/
*.nmo
*.NMO
*.cmo
*.CMO
/re/
/out/
*.iso
*.cue
*.mdf
*.nrg

# Build output
/build/
/build*/
/dist/

# Docs site
node_modules/
docs/.vitepress/cache/
docs/.vitepress/dist/
docs/public/play/*.wasm

# Play page runtime, copied from npm by docs/scripts/vendor-web.sh
docs/public/play/vendor/

