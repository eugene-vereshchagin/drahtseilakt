/.deps/

# Python
tools/.venv/
__pycache__/
*.pyc

# OS / editor
.DS_Store
*.swp
.vscode/
.idea/


# Cargo build output
/target/

# Fuzzing: findings, logs and scratch files of the stable fuzzer (crates/fuzzkit), cargo-fuzz's corpus and build
/fuzz/artifacts/
/fuzz/corpus/
/fuzz/target/
/fuzz/coverage/

# Binary data. Owner, 2026-11-17: the BASE DATA (what scripts/pack-assets.sh puts into drahtseilakt-data-<V>.tar.gz:
# our parts and textures, fonts, sounds, the showcase, Parts_Test and the community .nmo maps) is in git, so a clone
# builds and plays. Not in git: the 13 picked maps assets/levels/drahtseilakt/NN-* (a level.bin there is over GitHub's
# 100 MB file limit; they ship as release assets, release.md), the .dtx and other derived files, the manual.
# The legacy level folders keep only their text sources.
/levels/**/*.*
!/levels/**/*.txt
!/levels/**/*.md
/levels-legacy_delme/**/level.bin
/levels-legacy_delme/**/level.gltf
/levels-legacy_delme/**/*.png
/levels-legacy_delme/**/*.jpg
/assets/levels/drahtseilakt/0[1-9]-*/**
/assets/levels/drahtseilakt/[1-9][0-9]-*/**
# ... except their text sources
!/assets/levels/drahtseilakt/[0-9][1-9]-*/level.txt
!/assets/levels/drahtseilakt/[1-9][0-9]-*/level.txt
# derived files, rebuilt by the toolbox/converter
/assets/levels/**/*.dtx
/assets/levels/**/level.source
/assets/levels/**/*.remaster/
/assets/levels/**/textures.original/
# the original's map files are never in git; only the community maps of the base data are (a file, not a pattern: new
# ones are added on purpose)
!/assets/levels/community/**/*.nmo
!/assets/levels/community/**/*.NMO

# The player's manual, generated by tools/make_manual.py (shipped inside assets/ of a build)
/assets/manual/

# The sound synthesizer's output (tools/audio-synth): rendered audio, and compare files that hold the original's
# sounds (for listening at home only, never committed)
/tools/audio-synth/generated/
/tools/audio-synth/compare/
/tools/audio-synth/theme-out/
/tools/audio-synth/__pycache__/
/third_party/
